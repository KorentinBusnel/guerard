# Clé SERVEUR (scripts uniquement : prepare:route, create:style). Jamais commitée, jamais dans le bundle.
MAPMAP_API_KEY=

# Clé NAVIGATEUR, restreinte à l'origine du site (obligatoire en prod : sans clé, les tuiles
# répondent 403 hors de localhost). Facultative en développement local.
VITE_MAPMAP_KEY=

# URL du style hébergé « backyard-guerard-foret » (sortie de `npm run create:style`).
# Vide → repli DEV : le thème est compilé par le compilateur réduit du SDK + relief SDK.
VITE_MAPMAP_STYLE_URL=
